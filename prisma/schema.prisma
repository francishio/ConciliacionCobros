// schema.prisma — Conciliación HIOPOS
// Modelo canónico v1. Referencia: docs/modelo-datos-conciliacion-v1.md
//
// Nota RLS: Prisma no gestiona Row-Level Security. El aislamiento multi-tenant
// se aplica con políticas RLS en una migración SQL aparte (sobre la columna
// tenant_id) + scoping en la capa de aplicación. Ver docs de arquitectura §5.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"] // omitir columnas pesadas (raw) en queries del matcher
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────

enum EstadoOperativa {
  PENDIENTE
  OK
  DIFERENCIA_MONTO
  SIN_TRANSACCION
  EN_REVISION
  NO_APLICA
}

enum EstadoFinanciera {
  PENDIENTE
  PARCIAL
  ACREDITADO
  DIFERENCIA
  CONTRACARGO
  NO_APLICA
}

enum Rol {
  SUPERADMIN // vos (ICG): gestiona clientes, credenciales HIOPOS y catálogo de pasarelas
  CLIENTE // usuario de un tenant: ve solo sus tiendas
}

enum ModoIngesta {
  MANUAL // el cliente sube el extracto (archivo)
  API // se obtiene por API con las credenciales del cliente
}

enum EstadoSugerencia {
  NUEVO
  ACEPTADO
  RECHAZADO
  IMPLEMENTADO
}

// Usuarios del sistema. Control-plane (se accede vía adminDb, no RLS): el login
// busca por email a través de todos los tenants. SUPERADMIN tiene tenantId null.
model Usuario {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  nombre       String?
  rol          Rol       @default(CLIENTE)
  tenantId     String? // null para SUPERADMIN
  activo       Boolean   @default(true)
  ultimoLogin  DateTime?
  creadoEn     DateTime  @default(now())

  tenant      Tenant?      @relation(fields: [tenantId], references: [id])
  sugerencias Sugerencia[]

  @@map("usuario")
}

// Sugerencias que cada usuario deja para ICG. El usuario ve SOLO las suyas; el
// SUPERADMIN ve todas y edita el comentario y el estado. Control-plane (adminDb,
// scope por usuarioId; no RLS por tenant).
model Sugerencia {
  id            String           @id @default(uuid())
  usuarioId     String
  descripcion   String
  comentarioHio String? // solo lo edita el SUPERADMIN (ICG)
  estado        EstadoSugerencia @default(NUEVO)
  creadoEn      DateTime         @default(now())
  actualizadoEn DateTime         @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sugerencia")
}

// Catálogo de pasarelas de cobro (Payway, MercadoPago, Clover/Fiserv, …).
// Global (no por-tenant): define el universo; qué usa cada cliente lo captura
// MapeoEstablecimientoPasarela. Los campos `proveedor` de las otras tablas
// guardan el `codigo` de acá.
model Pasarela {
  id       String   @id @default(uuid())
  codigo   String   @unique // clave estable: 'PAYWAY', 'MERCADOPAGO', … (la guardan Transaccion/Mapeo/Cuenta)
  nombre   String // etiqueta visible: 'Payway', 'Mercado Pago'
  urlApi   String? // base URL para consumir la API (ej. https://api.la.clover.com)
  orden    Int      @default(100)
  creadoEn DateTime @default(now())

  @@map("pasarela")
}

enum EstadoTransaccion {
  APROBADA
  ANULADA
  DEVUELTA
  CONTRACARGO
}

enum TipoTarjeta {
  CREDITO
  DEBITO
}

enum TipoMatch {
  DETERMINISTICO
  FUZZY
  MANUAL
}

enum EstadoMatch {
  AUTO
  CONFIRMADO_MANUAL
  DESCARTADO
}

enum TipoMovimiento {
  ACREDITACION
  CONTRACARGO
  DEVOLUCION
  AJUSTE
}

enum TipoRetencion {
  IVA
  IIBB
  GANANCIAS
  OTRA
}

enum TipoExcepcion {
  COBRO_SIN_TRANSACCION
  TRANSACCION_SIN_COBRO
  DIFERENCIA_MONTO
  COMISION_INESPERADA
  RETENCION_NO_ESPERADA
  CONTRACARGO
  CUOTA_NO_ACREDITADA
  FUZZY_AMBIGUO
}

enum EstadoExcepcion {
  ABIERTA
  EN_REVISION
  RESUELTA
  IGNORADA
}

// ─── Modelos ─────────────────────────────────────────────────────────

model Tenant {
  id       String   @id @default(uuid())
  nombre   String
  numeroBD String? // nº de base de datos del cliente (HIOPOS/ICG)
  creadoEn DateTime @default(now())

  cobros            Cobro[]
  transacciones     Transaccion[]
  liquidaciones     Liquidacion[]
  excepciones       Excepcion[]
  matches           Match[]
  liquidacionLineas LiquidacionLinea[]
  retenciones       Retencion[]
  mapeosMedioPago   MapeoMedioPago[]
  establecimientos  Establecimiento[]
  mapeosPasarela    MapeoEstablecimientoPasarela[]
  cuentasPasarela   CuentaPasarela[]
  dispositivosPasarela DispositivoPasarela[]
  matchingProfile   MatchingProfile?
  configHiopos      ConfigHiopos?
  usuarios          Usuario[]

  @@map("tenant")
}

// Establecimiento / tienda dentro de una empresa (Tenant). Los cobros de HIOPOS
// se anclan por su "Cód. Tienda"; las transacciones de pasarela se linkean por
// mapeo (la numeración difiere por proveedor). La conciliación scopea por acá.
model Establecimiento {
  id           String   @id @default(uuid())
  tenantId     String
  nombre       String
  codTienda    String? // Cód. Tienda de HIOPOS (ancla de los cobros)
  tipo         String? // physical / digital
  nombreFiscal String? // razón social
  cuit         String? // Nif / CUIT
  direccion    String? // datos del catálogo de tiendas de HIOPOS
  localidad    String? // población / localidad / ciudad
  provincia    String?
  codigoPostal String?
  grupo        String? // Grupo Tiendas
  telefono     String?
  email        String?
  raw          Json? // fila completa del export de Tiendas (lo no mapeado explícito)
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  cobros        Cobro[]
  transacciones Transaccion[]
  mapeosPasarela MapeoEstablecimientoPasarela[]
  cuentasPasarela CuentaPasarela[]
  dispositivosPasarela DispositivoPasarela[]

  @@unique([tenantId, codTienda])
  @@map("establecimiento")
}

// Mapea el código de establecimiento/terminal de una pasarela (Payway, MP, …) a
// una tienda HIOPOS. Permite asociar cada transacción de pasarela a su
// establecimiento y conciliar por tienda. Un código pertenece a una sola tienda;
// una tienda puede tener varios códigos (varias terminales) por proveedor.
model MapeoEstablecimientoPasarela {
  id                String    @id @default(uuid())
  tenantId          String
  establecimientoId String
  proveedor         String      // codigo de Pasarela (ej. 'PAYWAY')
  codigoExterno     String // nro de establecimiento/terminal de la pasarela (= identificador de la cuenta, p. ej. MID)
  modo              ModoIngesta @default(MANUAL) // archivo manual o API para esta pasarela en esta tienda
  cuentaPasarelaId  String? // cuenta (credencial) que usa este establecimiento para esta pasarela
  descripcion       String? // etiqueta libre opcional (ej. "Caja 1")
  activo            Boolean     @default(true)
  creadoEn          DateTime  @default(now())

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  establecimiento Establecimiento @relation(fields: [establecimientoId], references: [id], onDelete: Cascade)
  cuenta          CuentaPasarela? @relation(fields: [cuentaPasarelaId], references: [id], onDelete: SetNull)

  @@unique([tenantId, proveedor, codigoExterno])
  @@index([establecimientoId])
  @@index([cuentaPasarelaId])
  @@map("mapeo_establecimiento_pasarela")
}

// Cuenta de una pasarela para un cliente: el lugar ÚNICO de credenciales.
// Una fila por comercio/cuenta — Clover usa token por-MID, así que un cliente
// con varios comercios Clover tiene una fila por MID. La credencial se guarda
// CIFRADA (AES-256-GCM); en modo archivo no hay credencial (identificador = "").
model CuentaPasarela {
  id            String      @id @default(uuid())
  tenantId      String
  proveedor     String // codigo de Pasarela (CLOVER, MERCADOPAGO, PAYWAY)
  modo          ModoIngesta @default(API)
  identificador String      @default("") // MID de Clover / id de cuenta; "" para archivo
  credencialEnc String? // token/credencial cifrada (iv:tag:ciphertext b64); null en archivo
  descripcion   String? // etiqueta ("EL AERO - H5")
  // Mapeo OPCIONAL del dispositivo a HIOPOS (acota la conciliación):
  //   sin mapeo        → concilia contra todo
  //   establecimiento  → contra las ventas de ese establecimiento
  //   establecimiento + terminal → solo ese establecimiento + esa terminal
  establecimientoId String?
  terminal          String?
  activo        Boolean     @default(true)
  creadoEn      DateTime    @default(now())
  actualizadoEn DateTime    @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  establecimiento Establecimiento? @relation(fields: [establecimientoId], references: [id], onDelete: SetNull)
  mapeos          MapeoEstablecimientoPasarela[]
  dispositivos    DispositivoPasarela[]

  @@unique([tenantId, proveedor, identificador])
  @@index([establecimientoId])
  @@map("cuenta_pasarela")
}

// Dispositivos (terminales físicas) de una cuenta de pasarela, traídos de la API
// (ej. Clover /devices). Cada dispositivo se mapea a la tienda + terminal de
// HIOPOS donde opera, para atribuir bien las transacciones por tienda.
model DispositivoPasarela {
  id                String   @id @default(uuid())
  tenantId          String
  cuentaPasarelaId  String
  deviceId          String // id del dispositivo en la pasarela (Clover device.id)
  deviceNombre      String? // nombre en la pasarela (ej. NEBULA-CAJA2)
  serial            String?
  modelo            String?
  establecimientoId String? // tienda HIOPOS mapeada
  codTerminal       String? // terminal/caja HIOPOS mapeada
  creadoEn          DateTime @default(now())
  actualizadoEn     DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cuenta          CuentaPasarela   @relation(fields: [cuentaPasarelaId], references: [id], onDelete: Cascade)
  establecimiento Establecimiento? @relation(fields: [establecimientoId], references: [id], onDelete: SetNull)

  @@unique([cuentaPasarelaId, deviceId])
  @@index([tenantId])
  @@index([establecimientoId])
  @@map("dispositivo_pasarela")
}

// Mapea cada medio de pago de HIOPOS a la conciliación (proveedor) a la que
// pertenece. proveedor = null → NO CONCILIABLE (ej. EFECTIVO) → estadoOp NO_APLICA.
// La expo de HIOPOS trae todos los medios juntos; esto separa cada cruce.
model MapeoMedioPago {
  id           String   @id @default(uuid())
  tenantId     String
  codMedioPago String // Cód. Medio Pago de HIOPOS (clave estable, aunque renombren el medio)
  medioPago    String // nombre del medio para mostrar (ej. "Débito Otras")
  proveedor    String? // codigo de Pasarela; null = NO CONCILIABLE (ej. efectivo)
  creadoEn     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, codMedioPago])
  @@map("mapeo_medio_pago")
}

// Credenciales del Bridge Hioffice (HIOPOS) por cliente + Exportation ID.
// La password se guarda CIFRADA (AES-256-GCM). Un solo export: las ventas de
// medios integrados (ya trae el establecimiento embebido en cada fila).
model ConfigHiopos {
  id             String   @id @default(uuid())
  tenantId       String   @unique
  apiUser        String
  apiPasswordEnc String? // cifrada (iv:tag:ciphertext en base64); null = sin setear
  expIdVentas    String? // Exportation ID (ventas de medios integrados; GUID o entero como string)
  actualizadoEn  DateTime @updatedAt
  creadoEn       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("config_hiopos")
}

model MatchingProfile {
  id               String  @id @default(uuid())
  tenantId         String  @unique
  determDisponible Boolean @default(false) // ¿existe clave determinística?
  ventanaMin       Int     @default(5) // tolerancia temporal fuzzy (min)
  tolMonto         Decimal @default(0) @db.Decimal(12, 2) // tolerancia de monto

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("matching_profile")
}

model Cobro {
  id                String           @id @default(uuid())
  tenantId          String
  establecimientoId String?
  codTerminal       String? // Cód. Terminal de HIOPOS (para scope por terminal)
  aliasTerminal     String? // Alias de la terminal (ej. "CAJA 01")
  hioposTicketId    String
  medioPago       String
  codMedioPago    String? // Cód. Medio Pago de HIOPOS (clave estable del mapeo)
  importe         Decimal          @db.Decimal(12, 2)
  cuotas          Int              @default(1)
  fechaHora       DateTime
  codAutorizacion String? // clave determinística (si integrado)
  refPasarela     String? // ref. de la pasarela que HIOPOS estampa (Clover: payment id de "Datos Transacción") — clave única global
  ultimos4        String? // para matching fuzzy
  marca           String? // marca de tarjeta (VISA/MASTERCARD/…) para matching fuzzy
  tipoTarjeta     TipoTarjeta? // CREDITO/DEBITO — narrowing fuzzy
  origenRef       String // clave natural del origen (idempotencia de ingesta)
  periodo         String? // bloque mensual YYYY-MM (se define al cargar)
  raw             Json? // payload crudo del origen (auditoría)
  estadoOp        EstadoOperativa  @default(PENDIENTE) // proyección → write-back HIOPOS
  estadoFin       EstadoFinanciera @default(PENDIENTE) // proyección → write-back HIOPOS
  creadoEn        DateTime         @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  establecimiento Establecimiento? @relation(fields: [establecimientoId], references: [id])
  matches         Match[]
  excepciones     Excepcion[]

  @@unique([tenantId, origenRef]) // idempotencia de ingesta
  @@index([tenantId, fechaHora])
  @@index([tenantId, codAutorizacion])
  @@index([tenantId, refPasarela])
  @@index([tenantId, ultimos4, importe])
  @@index([establecimientoId])
  @@index([tenantId, periodo])
  @@map("cobro")
}

model Transaccion {
  id                String            @id @default(uuid())
  tenantId          String
  establecimientoId String?
  proveedor         String // codigo de Pasarela (ej. 'PAYWAY')
  idExterno         String // MP payment_id / Payway TID
  importeBruto      Decimal           @db.Decimal(12, 2)
  cuotas            Int               @default(1)
  externalReference String? // ticket HIOPOS estampado (MP) — clave determinística MP
  codAutorizacion   String? // cód. autorización de tarjeta — clave determinística Clover/Payway
  terminal          String? // nro de establecimiento/comercio (MID) reportado por la pasarela (fallback de scope)
  deviceId          String? // id del dispositivo físico de la pasarela (Clover device.id) → mapea a tienda/terminal
  marca             String? // marca de tarjeta (VISA/MASTERCARD/…) para matching fuzzy
  ultimos4          String? // últimos 4 de la tarjeta — para matching fuzzy
  tipoTarjeta       TipoTarjeta? // CREDITO/DEBITO — narrowing fuzzy
  estado            EstadoTransaccion @default(APROBADA)
  fechaHora         DateTime
  periodo           String? // bloque mensual YYYY-MM (se define al cargar)
  raw               Json // payload crudo del proveedor (auditoría)
  creadoEn          DateTime          @default(now())

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  establecimiento   Establecimiento?   @relation(fields: [establecimientoId], references: [id])
  matches           Match[]
  liquidacionLineas LiquidacionLinea[]
  excepciones       Excepcion[]

  @@unique([tenantId, proveedor, idExterno]) // idempotencia de ingesta
  @@index([tenantId, fechaHora])
  @@index([tenantId, codAutorizacion]) // match determinístico
  @@index([establecimientoId])
  @@index([tenantId, periodo])
  @@map("transaccion")
}

model Liquidacion {
  id                String   @id @default(uuid())
  tenantId          String
  proveedor         String // codigo de Pasarela (ej. 'PAYWAY')
  fechaAcreditacion DateTime @db.Date
  netoTotal         Decimal  @db.Decimal(14, 2)
  creadoEn          DateTime @default(now())

  tenant Tenant             @relation(fields: [tenantId], references: [id])
  lineas LiquidacionLinea[]

  @@index([tenantId, fechaAcreditacion])
  @@map("liquidacion")
}

model LiquidacionLinea {
  id             String         @id @default(uuid())
  tenantId       String
  liquidacionId  String
  transaccionId  String? // nullable: ajustes sin transacción asociada
  nroCuota       Int            @default(1)
  bruto          Decimal        @db.Decimal(12, 2)
  arancel        Decimal        @default(0) @db.Decimal(12, 2)
  retenciones    Decimal        @default(0) @db.Decimal(12, 2) // total denormalizado
  neto           Decimal        @db.Decimal(12, 2)
  tipoMov        TipoMovimiento @default(ACREDITACION)

  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  liquidacion    Liquidacion  @relation(fields: [liquidacionId], references: [id])
  transaccion    Transaccion? @relation(fields: [transaccionId], references: [id])
  retencionesDet Retencion[]

  @@index([tenantId])
  @@index([transaccionId])
  @@index([liquidacionId])
  @@map("liquidacion_linea")
}

model Retencion {
  id                 String        @id @default(uuid())
  tenantId           String
  liquidacionLineaId String
  tipo               TipoRetencion
  jurisdiccion       String? // para IIBB por provincia
  monto              Decimal       @db.Decimal(12, 2)

  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  liquidacionLinea LiquidacionLinea @relation(fields: [liquidacionLineaId], references: [id])

  @@index([tenantId])
  @@index([liquidacionLineaId])
  @@map("retencion")
}

model Match {
  id            String      @id @default(uuid())
  tenantId      String
  cobroId       String
  transaccionId String
  tipo          TipoMatch
  score         Float? // para fuzzy
  estado        EstadoMatch @default(AUTO)
  creadoEn      DateTime    @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  cobro       Cobro       @relation(fields: [cobroId], references: [id])
  transaccion Transaccion @relation(fields: [transaccionId], references: [id])

  @@index([tenantId])
  @@index([cobroId])
  @@index([transaccionId])
  @@map("match")
}

model Excepcion {
  id            String          @id @default(uuid())
  tenantId      String
  tipo          TipoExcepcion
  estado        EstadoExcepcion @default(ABIERTA)
  cobroId       String?
  transaccionId String?
  nota          String?
  creadoEn      DateTime        @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  cobro       Cobro?       @relation(fields: [cobroId], references: [id])
  transaccion Transaccion? @relation(fields: [transaccionId], references: [id])

  @@index([tenantId, estado])
  @@map("excepcion")
}
