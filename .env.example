# Base de datos — Neon (PostgreSQL)

# Runtime / data plane — rol app_runtime (RLS aplicada), pooled (host con -pooler)
DATABASE_URL=postgresql://app_runtime:PASS@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true

# Migraciones — neondb_owner, conexión directa (host SIN -pooler)
DIRECT_URL=postgresql://neondb_owner:PASS@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Control plane / admin (cross-tenant: enumerar tenants, seed) — neondb_owner pooled
ADMIN_DATABASE_URL=postgresql://neondb_owner:PASS@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true

# Sesión — secreto para firmar el JWT de la cookie (cualquier string largo y aleatorio)
AUTH_SECRET=cambia-esto-por-un-secreto-largo-aleatorio

# Cifrado de credenciales de pasarela (AES-256-GCM). Clave de 32 bytes en base64/hex.
CONFIG_ENC_KEY=cambia-esto-por-una-clave-de-32-bytes

# Ingreso con Google (OpenID Connect). Credenciales del cliente OAuth en Google Cloud.
# Redirect URI autorizado: https://<tu-dominio>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: dominio canónico en producción (evita problemas con permalinks de deploy de Netlify)
# APP_CANONICAL_HOST=concilia-cobros.netlify.app

# Entorno — SOLO para desarrollo local.
# ⚠ NO cargar esta variable en Netlify/producción: ahí Next usa production solo.
# Si se pone NODE_ENV=development en Netlify, el build sale en modo desarrollo y
# falla al generar /404 y /500 (<Html> should not be imported...). En Netlify:
# o no se define NODE_ENV, o se define en "production".
NODE_ENV=development
