# Base de datos — Neon (PostgreSQL)

# Runtime / data plane — rol app_runtime (RLS aplicada), pooled (host con -pooler)
DATABASE_URL=postgresql://app_runtime:PASS@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true

# Migraciones — neondb_owner, conexión directa (host SIN -pooler)
DIRECT_URL=postgresql://neondb_owner:PASS@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Control plane / admin (cross-tenant: enumerar tenants, seed) — neondb_owner pooled
ADMIN_DATABASE_URL=postgresql://neondb_owner:PASS@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true

# Entorno
NODE_ENV=development
